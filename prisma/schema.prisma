generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PLAYER
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum PickSide {
  HOME
  AWAY
}

enum RoomMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum TournamentType {
  WORLD_CUP
  INTERNATIONAL_CUP
  CLUB_TOURNAMENT
  DOMESTIC_LEAGUE
  CUSTOM
}

enum RoomConfigPreset {
  BASIC
  INTERMEDIATE
  COMPLETE
  CUSTOM
}

enum RoomDeadlineMode {
  PER_MATCH
  PHASE
}

enum PopularPredictionsVisibility {
  ALWAYS
  AFTER_PICK
  AFTER_DEADLINE
  HIDDEN
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CompetitionPhaseFormat {
  GROUP
  KNOCKOUT
  LEAGUE
}

model User {
  id                     String                 @id @default(cuid())
  username               String                 @unique
  displayName            String
  passwordHash           String
  role                   Role                   @default(PLAYER)
  isActive               Boolean                @default(true)
  canParticipate         Boolean                @default(true)
  sessions               Session[]
  predictions            Prediction[]
  predictionAnswers      PredictionAnswer[]
  ownedRooms             Room[]                 @relation("RoomOwner")
  roomMembers            RoomMember[]
  roomLeaderboardEntries RoomLeaderboardEntry[]
  tournamentPicks        RoomTournamentPick[]
  notificationRecipients NotificationRecipient[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id             String       @id @default(cuid())
  name           String       @unique
  normalizedName String       @unique
  groupCode      String?
  logoUrl        String?
  homeMatches    Match[]      @relation("HomeTeam")
  awayMatches    Match[]      @relation("AwayTeam")
  actualWins     Match[]      @relation("ActualWinner")
  predictions    Prediction[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Competition {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  type                TournamentType
  status              CompetitionStatus    @default(DRAFT)
  season              String?
  timezone            String               @default("America/Guatemala")
  countryCode         String?
  logoUrl             String?
  bannerUrl           String?
  startsAt            DateTime?
  endsAt              DateTime?
  championTeamId      String?
  apiFootballLeagueId Int?                 @unique
  championTeam        CompetitionTeam?     @relation("CompetitionChampion", fields: [championTeamId], references: [id], onDelete: SetNull)
  phases              CompetitionPhase[]
  teams               CompetitionTeam[]    @relation("CompetitionTeams")
  matches             CompetitionMatch[]
  rooms               Room[]
  championPicks       RoomTournamentPick[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status])
  @@index([type])
}

model CompetitionPhase {
  id                  String                 @id @default(cuid())
  competitionId       String
  name                String
  stage               MatchStage?
  format              CompetitionPhaseFormat
  sortOrder           Int                    @default(0)
  groupCode           String?
  automaticQualifiers Int                    @default(0)
  bestThirdQualifiers Int                    @default(0)
  startsAt            DateTime?
  endsAt              DateTime?
  competition         Competition            @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches             CompetitionMatch[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([competitionId, sortOrder])
  @@index([competitionId])
  @@index([format])
}

model CompetitionTeam {
  id             String               @id @default(cuid())
  competitionId  String
  name           String
  normalizedName String
  groupCode      String?
  logoUrl        String?
  competition    Competition          @relation("CompetitionTeams", fields: [competitionId], references: [id], onDelete: Cascade)
  championOf     Competition[]        @relation("CompetitionChampion")
  homeMatches    CompetitionMatch[]   @relation("CompetitionHomeTeam")
  awayMatches    CompetitionMatch[]   @relation("CompetitionAwayTeam")
  actualWins     CompetitionMatch[]   @relation("CompetitionActualWinner")
  predictedWins  Prediction[]         @relation("PredictedCompetitionWinner")
  championPicks  RoomTournamentPick[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([competitionId, normalizedName])
  @@index([competitionId])
  @@index([groupCode])
}

model CompetitionMatch {
  id                 String              @id @default(cuid())
  competitionId      String
  phaseId            String?
  matchNumber        Int?
  kickoffAt          DateTime?
  venue              String?
  homeTeamId         String?
  awayTeamId         String?
  homePlaceholder    String?
  awayPlaceholder    String?
  status             MatchStatus         @default(SCHEDULED)
  homeScore          Int?
  awayScore          Int?
  actualWinnerSide   PickSide?
  actualWinnerTeamId String?
  externalFixtureId  Int?                @unique
  competition        Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phase              CompetitionPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  homeTeam           CompetitionTeam?    @relation("CompetitionHomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           CompetitionTeam?    @relation("CompetitionAwayTeam", fields: [awayTeamId], references: [id])
  actualWinnerTeam   CompetitionTeam?    @relation("CompetitionActualWinner", fields: [actualWinnerTeamId], references: [id])
  predictions        Prediction[]
  predictionAnswers  PredictionAnswer[]
  marketResults      MatchMarketResult[]
  notifications      Notification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([competitionId, matchNumber])
  @@index([competitionId])
  @@index([phaseId])
  @@index([kickoffAt])
}

model Match {
  id                 String              @id @default(cuid())
  matchNumber        Int                 @unique
  stage              MatchStage
  groupCode          String?
  dateLabel          String?
  timeLabel          String?
  kickoffAt          DateTime?
  venue              String?
  venueShort         String?
  homeTeamId         String?
  awayTeamId         String?
  homePlaceholder    String?
  awayPlaceholder    String?
  homeScore          Int?
  awayScore          Int?
  actualWinnerTeamId String?
  actualWinnerSide   PickSide?
  actualWinnerLabel  String?
  status             MatchStatus         @default(SCHEDULED)
  homeTeam           Team?               @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?               @relation("AwayTeam", fields: [awayTeamId], references: [id])
  actualWinnerTeam   Team?               @relation("ActualWinner", fields: [actualWinnerTeamId], references: [id])
  predictions        Prediction[]
  predictionAnswers  PredictionAnswer[]
  marketResults      MatchMarketResult[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([stage])
  @@index([kickoffAt])
}

model Room {
  id                           String                       @id @default(cuid())
  name                         String
  accessCode                   String                       @unique
  tournamentType               TournamentType
  tournamentName               String
  externalTournamentId         String?
  configPreset                 RoomConfigPreset             @default(BASIC)
  deadlineMode                 RoomDeadlineMode             @default(PER_MATCH)
  deadlineHoursBefore          Int                          @default(1)
  popularPredictionsVisibility PopularPredictionsVisibility @default(AFTER_PICK)
  championPickEnabled          Boolean                      @default(true)
  championPickPoints           Int                          @default(5)
  championPickDeadline         DateTime?
  status                       RoomStatus                   @default(ACTIVE)
  ownerId                      String
  owner                        User                         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  competition                  Competition?                 @relation(fields: [externalTournamentId], references: [id], onDelete: SetNull)
  members                      RoomMember[]
  ruleSet                      RoomRuleSet?
  ruleVersions                 RoomRuleVersion[]
  predictions                  Prediction[]
  predictionAnswers            PredictionAnswer[]
  leaderboardEntries           RoomLeaderboardEntry[]
  championPicks                RoomTournamentPick[]
  notifications                Notification[]
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([tournamentType])
  @@index([externalTournamentId])
}

model RoomMember {
  id        String         @id @default(cuid())
  roomId    String
  userId    String
  role      RoomMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())
  room      Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([roomId, userId])
  @@index([userId])
  @@index([role])
}

model RoomRuleSet {
  id                 String           @id @default(cuid())
  roomId             String           @unique
  preset             RoomConfigPreset @default(BASIC)
  exactScorePoints   Int              @default(3)
  outcomePoints      Int              @default(1)
  advancePickPoints  Int              @default(1)
  enabledMarkets     Json
  customMarketConfig Json?
  room               Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

/// Foto de las reglas de puntuacion vigentes desde effectiveFrom. Un partido se puntua con la
/// version vigente a su kickoff, asi un cambio de reglas no repuntea lo ya jugado.
model RoomRuleVersion {
  id                 String   @id @default(cuid())
  roomId             String
  effectiveFrom      DateTime
  exactScorePoints   Int
  outcomePoints      Int
  advancePickPoints  Int
  enabledMarkets     Json
  customMarketConfig Json?
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())

  @@index([roomId, effectiveFrom])
}

model Prediction {
  id                               String            @id @default(cuid())
  userId                           String
  matchId                          String?
  competitionMatchId               String?
  roomId                           String?
  predictedHomeScore               Int?
  predictedAwayScore               Int?
  predictedWinnerTeamId            String?
  predictedWinnerCompetitionTeamId String?
  predictedWinnerSide              PickSide?
  points                           Int               @default(0)
  user                             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                            Match?            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  competitionMatch                 CompetitionMatch? @relation(fields: [competitionMatchId], references: [id], onDelete: Cascade)
  room                             Room?             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  predictedWinnerTeam              Team?             @relation(fields: [predictedWinnerTeamId], references: [id])
  predictedWinnerCompetitionTeam   CompetitionTeam?  @relation("PredictedCompetitionWinner", fields: [predictedWinnerCompetitionTeamId], references: [id])
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt

  @@unique([roomId, userId, matchId])
  @@unique([roomId, userId, competitionMatchId])
  @@index([userId, matchId])
  @@index([matchId])
  @@index([competitionMatchId])
  @@index([roomId])
}

model PredictionAnswer {
  id                 String            @id @default(cuid())
  roomId             String
  userId             String
  matchId            String?
  competitionMatchId String?
  marketKey          String
  value              Json
  points             Int               @default(0)
  room               Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  match              Match?            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  competitionMatch   CompetitionMatch? @relation(fields: [competitionMatchId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([roomId, userId, matchId, marketKey])
  @@unique([roomId, userId, competitionMatchId, marketKey])
  @@index([roomId, matchId])
  @@index([roomId, competitionMatchId])
  @@index([userId])
  @@index([marketKey])
}

model MatchMarketResult {
  id                 String            @id @default(cuid())
  matchId            String?
  competitionMatchId String?
  marketKey          String
  value              Json
  match              Match?            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  competitionMatch   CompetitionMatch? @relation(fields: [competitionMatchId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([matchId, marketKey])
  @@unique([competitionMatchId, marketKey])
  @@index([competitionMatchId])
  @@index([marketKey])
}

model RoomTournamentPick {
  id              String          @id @default(cuid())
  roomId          String
  userId          String
  competitionId   String
  predictedTeamId String
  points          Int             @default(0)
  room            Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition     Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  predictedTeam   CompetitionTeam @relation(fields: [predictedTeamId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([roomId, userId, competitionId])
  @@index([roomId, points])
  @@index([competitionId])
}

model RoomLeaderboardEntry {
  roomId          String
  userId          String
  totalPoints     Int      @default(0)
  predictionCount Int      @default(0)
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@id([roomId, userId])
  @@index([roomId, totalPoints(sort: Desc), userId])
  @@index([userId])
}

model ScoringSettings {
  id                    String   @id @default("default")
  groupExactPoints      Int      @default(3)
  groupOutcomePoints    Int      @default(2)
  knockoutAdvancePoints Int      @default(3)
  updatedAt             DateTime @updatedAt
}

model Notification {
  id                 String                  @id @default(cuid())
  roomId             String
  competitionMatchId String?
  type               String                  @default("MATCH_RESULT")
  title              String
  body               String
  room               Room                    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  competitionMatch   CompetitionMatch?       @relation(fields: [competitionMatchId], references: [id], onDelete: Cascade)
  recipients         NotificationRecipient[]
  createdAt          DateTime                @default(now())

  @@index([roomId])
  @@index([competitionMatchId])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}
